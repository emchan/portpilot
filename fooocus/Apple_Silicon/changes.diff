+def get_resource_meter():
+    import psutil, torch
+    try:
+        import ldm_patched.modules.model_management as mm
+        dev = mm.get_torch_device()
+        accel = str(dev)
+        # friendlier name
+        if hasattr(dev, 'type'):
+            if dev.type == 'cuda':
+                try:
+                    accel = 'GPU (CUDA: ' + torch.cuda.get_device_name(dev) + ')'
+                except Exception:
+                    accel = 'GPU (CUDA)'
+            elif dev.type == 'mps':
+                accel = 'GPU (Apple MPS/Metal)'
+            elif dev.type == 'npu':
+                accel = 'NPU (Ascend)'
+            elif dev.type == 'xpu':
+                accel = 'GPU (Intel XPU)'
+            elif dev.type == 'cpu':
+                accel = 'CPU'
+    except Exception:
+        accel = 'unknown'
+    ram = psutil.virtual_memory()
+    ram_used = ram.used / (1024**3)
+    ram_total = ram.total / (1024**3)
+    vram_str = ''
+    try:
+        import ldm_patched.modules.model_management as mm
+        dev = mm.get_torch_device()
+        if hasattr(dev, 'type') and dev.type == 'cuda':
+            free, total = torch.cuda.mem_get_info(dev)
+            vram_str = ' | VRAM: %.1f/%.1f GB' % ((total - free) / (1024**3), total / (1024**3))
+        elif hasattr(dev, 'type') and dev.type == 'npu':
+            free, total = torch.npu.mem_get_info(dev)
+            vram_str = ' | NPU: %.1f/%.1f GB' % ((total - free) / (1024**3), total / (1024**3))
+        elif hasattr(dev, 'type') and dev.type == 'xpu':
+            if hasattr(torch.xpu, 'mem_get_info'):
+                free, total = torch.xpu.mem_get_info(dev)
+                vram_str = ' | XPU: %.1f/%.1f GB' % ((total - free) / (1024**3), total / (1024**3))
+    except Exception:
+        pass
+    return '<div style="font-size:12px;padding:4px 8px;">Accelerator: <b>%s</b> | RAM: %.1f/%.1f GB%s</div>' % (accel, ram_used, ram_total, vram_str)
+
