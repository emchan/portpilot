+# ---------------------------------------------------------------------
+# Client side of the NPU bridge: talks to npu/server.py over HTTP.
+# Used by Fooocus (x64 process). Spawns the ARM64 server if needed.
+# ---------------------------------------------------------------------
+import base64
+import io
+import json
+import os
+import subprocess
+import sys
+import time
+import urllib.request
+import urllib.error
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DEFAULT_PORT = 7867
+DEFAULT_HOST = "127.0.0.1"
+DEFAULT_PYTHON = os.path.abspath(os.path.join(HERE, "..", "..", "qnn_env", "Scripts", "python.exe"))
+DEFAULT_MODEL = os.path.abspath(os.path.join(HERE, "..", "..", "sd_xl_npu"))
+DEFAULT_SERVER = os.path.join(HERE, "server.py")
+
+
+def _env(name, default):
+    v = os.environ.get(name)
+    return v if v else default
+
+
+def server_url():
+    host = _env("FOOOCUS_NPU_HOST", DEFAULT_HOST)
+    port = int(_env("FOOOCUS_NPU_PORT", str(DEFAULT_PORT)))
+    return f"http://{host}:{port}"
+
+
+def _health(timeout=2):
+    url = server_url() + "/health"
+    try:
+        with urllib.request.urlopen(url, timeout=timeout) as r:
+            data = json.loads(r.read().decode("utf-8"))
+            return data.get("ready") is True, data
+    except Exception:
+        return False, None
+
+
+def backend_info():
+    """Return the /health payload (backend, sizes, ...) or None if unavailable."""
+    ok, data = _health(timeout=3)
+    return data if ok else None
+
+
+def _post_json(path, payload, timeout=600):
+    ensure_server()
+    req = urllib.request.Request(
+        server_url() + path,
+        data=json.dumps(payload).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+    )
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        return json.loads(r.read().decode("utf-8"))
+
+
+def tagger(png_bytes, model_onnx, model_csv, threshold=0.35, character_threshold=0.85,
+           exclude_tags="", timeout=600):
+    """Run the WD14 tagger on the ARM64 server; returns the tag string."""
+    return _post_json("/tagger", {
+        "png": base64.b64encode(png_bytes).decode("ascii"),
+        "model_onnx": model_onnx,
+        "model_csv": model_csv,
+        "threshold": float(threshold),
+        "character_threshold": float(character_threshold),
+        "exclude_tags": str(exclude_tags),
+    }, timeout=timeout)["tags"]
+
+
+def mask(png_bytes, model_path, timeout=600):
+    """Run a U2Net-family matting model on the ARM64 server; returns an HxW uint8 array."""
+    data = _post_json("/mask", {
+        "png": base64.b64encode(png_bytes).decode("ascii"),
+        "model_path": model_path,
+    }, timeout=timeout)
+    from PIL import Image
+    img = Image.open(io.BytesIO(base64.b64decode(data["png"]))).convert("L")
+    return __import__("numpy").asarray(img)
+
+
+def inpaint(fill_png, mask_png, prompt, negative="", steps=8, cfg=2.0, seed=42,
+            strength=1.0, timeout=1800):
+    """Run SDXL inpaint on the ARM64 server; returns an HWC uint8 image."""
+    data = _post_json("/inpaint", {
+        "fill_png": base64.b64encode(fill_png).decode("ascii"),
+        "mask_png": base64.b64encode(mask_png).decode("ascii"),
+        "prompt": prompt,
+        "negative": negative,
+        "steps": int(steps),
+        "cfg": float(cfg),
+        "seed": int(seed),
+        "strength": float(strength),
+    }, timeout=timeout)
+    from PIL import Image
+    img = Image.open(io.BytesIO(base64.b64decode(data["png"]))).convert("RGB")
+    return __import__("numpy").asarray(img)
+
+
+def ensure_server(timeout=180):
+    ok, _ = _health(timeout=2)
+    if ok:
+        return True
+    host = _env("FOOOCUS_NPU_HOST", DEFAULT_HOST)
+    port = _env("FOOOCUS_NPU_PORT", str(DEFAULT_PORT))
+    python = _env("FOOOCUS_NPU_PYTHON", DEFAULT_PYTHON)
+    model = _env("FOOOCUS_NPU_MODEL", DEFAULT_MODEL)
+    server = _env("FOOOCUS_NPU_SERVER", DEFAULT_SERVER)
+    log_path = os.path.join(HERE, f"server_{port}.log")
+    cmd = [python, server, "--model-dir", model, "--host", host, "--port", port]
+    print(f"[npu-bridge] spawning server: {' '.join(cmd)}", flush=True)
+    logf = open(log_path, "a", buffering=1)
+    creationflags = 0
+    if sys.platform == "win32":
+        creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
+    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, creationflags=creationflags)
+    # Poll health.
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        time.sleep(0.5)
+        ok, _ = _health(timeout=2)
+        if ok:
+            print("[npu-bridge] server ready", flush=True)
+            return True
+        if proc.poll() is not None:
+            raise RuntimeError(f"npu server exited early (code {proc.returncode}); see {log_path}")
+    raise TimeoutError(f"npu server did not become ready within {timeout}s; see {log_path}")
+
+
+def generate(prompt, negative="", steps=20, cfg=7.5, seed=42, count=1,
+            disable_seed_increment=False, on_progress=None, timeout=3600,
+            width=512, height=512):
+    ensure_server()
+    url = server_url() + "/generate"
+    payload = {
+        "prompt": prompt,
+        "negative": negative,
+        "steps": int(steps),
+        "cfg": float(cfg),
+        "seed": int(seed),
+        "count": int(count),
+        "disable_seed_increment": bool(disable_seed_increment),
+        "width": int(width),
+        "height": int(height),
+    }
+    data = json.dumps(payload).encode("utf-8")
+    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
+    results = []
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        for raw in r:
+            if not raw.strip():
+                continue
+            # Chunked transfer: lines may carry trailing CRLF; strip.
+            line = raw.strip()
+            # urlopen already de-chunks; but we may get partial lines? read line by line is fine.
+            try:
+                ev = json.loads(line.decode("utf-8"))
+            except json.JSONDecodeError:
+                continue
+            t = ev.get("type")
+            if t == "progress":
+                if on_progress is not None:
+                    try:
+                        on_progress(ev["index"], ev["step"], ev["total"], ev["elapsed"])
+                    except Exception:
+                        pass
+            elif t == "image":
+                png = base64.b64decode(ev["png"])
+                from PIL import Image
+                img = Image.open(io.BytesIO(png)).convert("RGB")
+                arr = __import__("numpy").asarray(img)
+                results.append((ev["index"], ev["seed"], arr))
+            elif t == "error":
+                raise RuntimeError("npu server error: " + ev.get("message", ""))
+            elif t == "done":
+                break
+    # Sort by index just in case.
+    results.sort(key=lambda x: x[0])
+    return [(s, a) for (_, s, a) in results]
