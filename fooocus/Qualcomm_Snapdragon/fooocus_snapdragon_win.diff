diff --git a/modules/npu_bridge.py b/modules/npu_bridge.py
new file mode 100644
index 0000000..658c168
--- /dev/null
+++ b/modules/npu_bridge.py
@@ -0,0 +1,310 @@
+import os
+import sys
+import time
+
+# Locate the npu package (Fooocus/npu) on sys.path.
+_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+_NPU_DIR = os.path.join(_REPO, "npu")
+if _NPU_DIR not in sys.path:
+    sys.path.insert(0, _NPU_DIR)
+
+import client as npu_client  # noqa: E402
+
+
+def enabled():
+    return os.environ.get("FOOOCUS_NPU", "").strip() in ("1", "true", "yes", "on")
+
+
+_last_backend = {"name": None, "ts": 0.0}
+
+
+def mark_backend(name):
+    """Record which accelerator actually served the last task (for the UI meter)."""
+    _last_backend["name"] = name
+    _last_backend["ts"] = time.time()
+
+
+def last_backend(max_age=180.0):
+    name = _last_backend["name"]
+    if name and (time.time() - _last_backend["ts"]) <= max_age:
+        return name
+    return None
+
+
+def supports_task(async_task):
+    """NPU backend is txt2img-only; inpaint/upscale/enhance must use the CPU pipeline."""
+    if getattr(async_task, "input_image_checkbox", False):
+        return False
+    if getattr(async_task, "enhance_checkbox", False):
+        return False
+    if getattr(async_task, "outpaint_selections", None):
+        return False
+    return True
+
+
+def supports_inpaint(async_task, goals):
+    """The Inpaint tab (and outpaint) can run on the NPU when the SDXL backend is up."""
+    if "inpaint" not in goals:
+        return False
+    if getattr(async_task, "enhance_checkbox", False):
+        return False
+    return True
+
+
+def _pad_outpaint(image, mask, selections):
+    import numpy as np
+
+    if not selections:
+        return image, mask
+    H, W, C = image.shape
+    if "top" in selections:
+        image = np.pad(image, [[int(H * 0.3), 0], [0, 0], [0, 0]], mode="edge")
+        mask = np.pad(mask, [[int(H * 0.3), 0], [0, 0]], mode="constant", constant_values=255)
+    if "bottom" in selections:
+        image = np.pad(image, [[0, int(H * 0.3)], [0, 0], [0, 0]], mode="edge")
+        mask = np.pad(mask, [[0, int(H * 0.3)], [0, 0]], mode="constant", constant_values=255)
+    H, W, C = image.shape
+    if "left" in selections:
+        image = np.pad(image, [[0, 0], [int(W * 0.3), 0], [0, 0]], mode="edge")
+        mask = np.pad(mask, [[0, 0], [int(W * 0.3), 0]], mode="constant", constant_values=255)
+    if "right" in selections:
+        image = np.pad(image, [[0, 0], [0, int(W * 0.3)], [0, 0]], mode="edge")
+        mask = np.pad(mask, [[0, 0], [0, int(W * 0.3)]], mode="constant", constant_values=255)
+    return np.ascontiguousarray(image.copy()), np.ascontiguousarray(mask.copy())
+
+
+def run_inpaint_task(async_task, image, mask, denoise, progressbar, yield_result, log,
+                     stop_processing, preparation_start_time):
+    """NPU inpaint: masked-latent blending on the SDXL UNet (no Fooocus inpaint head).
+
+    Returns True when the image was produced, False to let the CPU pipeline run.
+    """
+    mark_backend("NPU")
+    import io
+
+    import numpy as np
+    from PIL import Image
+    from modules.inpaint_worker import InpaintWorker
+
+    info = npu_client.backend_info()
+    if not info or info.get("backend") != "sdxl":
+        print("[npu-bridge] inpaint needs the SDXL backend; falling back to CPU")
+        return False
+
+    image, mask = _pad_outpaint(image, mask, getattr(async_task, "outpaint_selections", []) or [])
+    # Fooocus's InpaintWorker calls perform_upscale() (ESRGAN 4x on CPU) whenever the
+    # masked region is < 1024px. That costs minutes; let set_image_shape_ceil resize
+    # instead and spend the time on the NPU denoise pass.
+    import modules.inpaint_worker as _iw
+    _orig_upscale = _iw.perform_upscale
+    _iw.perform_upscale = lambda im: im
+    try:
+        worker = InpaintWorker(image=image, mask=mask,
+                               use_fill=float(denoise) > 0.99,
+                               k=float(getattr(async_task, "inpaint_respective_field", 0.618)))
+    finally:
+        _iw.perform_upscale = _orig_upscale
+    fill = worker.interested_fill
+    mask_l = worker.interested_mask
+
+    steps = int(getattr(async_task, "steps", 8) or 8)
+    cfg = float(getattr(async_task, "cfg_scale", 2.0))
+    if steps > 8:
+        print(f"[npu-bridge] SDXL inpaint: steps {steps} -> 8")
+        steps = 8
+    if cfg > 2.5:
+        print(f"[npu-bridge] SDXL inpaint: cfg {cfg} -> 2.0")
+        cfg = 2.0
+
+    progressbar(async_task, 2, "NPU inpaint: encoding region ...")
+    fill_buf = io.BytesIO()
+    Image.fromarray(np.asarray(fill, dtype=np.uint8)).save(fill_buf, format="PNG")
+    mask_buf = io.BytesIO()
+    Image.fromarray((np.asarray(mask_l) > 127).astype(np.uint8) * 255, mode="L").save(mask_buf, format="PNG")
+
+    def on_progress(i, total, elapsed=None):
+        progressbar(async_task, min(98, 2 + int(96 * i / max(1, total))),
+                    f"NPU inpaint step {i}/{total} ...")
+
+    try:
+        out = npu_client.inpaint(
+            fill_buf.getvalue(), mask_buf.getvalue(),
+            prompt=getattr(async_task, "prompt", "") or "",
+            negative=getattr(async_task, "negative_prompt", "") or "",
+            steps=steps, cfg=cfg, seed=int(getattr(async_task, "seed", 42)),
+            strength=float(denoise), timeout=3600)
+    except Exception as e:
+        print(f"[npu-bridge] NPU inpaint failed: {e}; falling back to CPU")
+        return False
+
+    progressbar(async_task, 99, "Compositing ...")
+    result = worker.post_process(np.asarray(out, dtype=np.uint8))
+    h, w = result.shape[:2]
+
+    metadata = [
+        ("Prompt", "prompt", getattr(async_task, "prompt", "") or ""),
+        ("Negative Prompt", "negative_prompt", getattr(async_task, "negative_prompt", "") or ""),
+        ("Backend", "backend", "SDXL inpaint on Hexagon NPU (QNN, w8a16)"),
+        ("Performance", "performance", "npu-sdxl-inpaint"),
+        ("Steps", "steps", steps),
+        ("Resolution", "resolution", str((w, h))),
+        ("Guidance Scale", "guidance_scale", cfg),
+        ("Denoise Strength", "denoise", float(denoise)),
+        ("Seed", "seed", int(getattr(async_task, "seed", 42))),
+        ("Base Model", "base_model", "dreamshaper-xl-lightning (NPU)"),
+    ]
+    path = log(result, metadata,
+               output_format=getattr(async_task, "output_format", None),
+               task={"positive": [getattr(async_task, "prompt", "") or ""],
+                     "negative": [getattr(async_task, "negative_prompt", "") or ""]},
+               persist_image=True)
+    yield_result(async_task, path, 100, getattr(async_task, "black_out_nsfw", False), True)
+    progressbar(async_task, 100, "Finished NPU inpaint.")
+    stop_processing(async_task, preparation_start_time)
+    return True
+
+
+def tagger_via_npu(image_rgb, model_onnx, model_csv, threshold=0.35,
+                   character_threshold=0.85, exclude_tags=""):
+    """WD14 interrogate on the ARM64 server (QNN or native CPU)."""
+    import io
+
+    from PIL import Image
+
+    buf = io.BytesIO()
+    Image.fromarray(image_rgb).save(buf, format="PNG")
+    return npu_client.tagger(buf.getvalue(), model_onnx, model_csv, threshold,
+                             character_threshold, exclude_tags)
+
+
+def mask_via_npu(image_rgb, model_path):
+    """U2Net-family matting on the ARM64 server; returns an HxW uint8 mask."""
+    import io
+
+    from PIL import Image
+
+    buf = io.BytesIO()
+    Image.fromarray(image_rgb).save(buf, format="PNG")
+    return npu_client.mask(buf.getvalue(), model_path)
+
+
+def run_task(async_task, progressbar, yield_result, log, stop_processing, preparation_start_time):
+    """Generate images via the NPU server and feed them into Fooocus's UI/log."""
+    mark_backend("NPU")
+    import numpy as np
+
+    steps = int(getattr(async_task, "steps", 0) or 20)
+    if steps < 1:
+        steps = 20
+    count = int(getattr(async_task, "image_number", 1) or 1)
+    if count < 1:
+        count = 1
+    cfg = float(getattr(async_task, "cfg_scale", 7.5))
+    seed = int(getattr(async_task, "seed", 42))
+    disable_inc = bool(getattr(async_task, "disable_seed_increment", False))
+    prompt = getattr(async_task, "prompt", "") or ""
+    negative = getattr(async_task, "negative_prompt", "") or ""
+    width = 512
+    height = 512
+
+    progressbar(async_task, 1, "Preparing NPU backend ...")
+    try:
+        npu_client.ensure_server()
+        info = npu_client.backend_info()
+    except Exception as e:
+        print(f"[npu-bridge] failed to start server: {e}")
+        progressbar(async_task, 100, f"NPU backend unavailable: {e}")
+        stop_processing(async_task, preparation_start_time)
+        return
+
+    backend = (info or {}).get("backend", "sd21")
+    sizes = (info or {}).get("sizes") or [((info or {}).get("size", 512),) * 2]
+
+    # Fooocus gives a pixel resolution string such as "1024×1024".
+    width, height = 512, 512
+    try:
+        parts = str(getattr(async_task, "aspect_ratios_selection", "")).replace("×", " ").split()
+        if len(parts) >= 2:
+            width, height = int(parts[0]), int(parts[1])
+    except Exception:
+        pass
+
+    if backend == "sdxl":
+        supported = [tuple(s) for s in sizes]
+        if (width, height) not in supported:
+            width, height = supported[0]
+        if steps > 8:
+            print(f"[npu-bridge] SDXL Lightning: steps {steps} -> 8")
+            steps = 8
+        if cfg > 2.5:
+            print(f"[npu-bridge] SDXL Lightning: cfg {cfg} -> 2.0")
+            cfg = 2.0
+
+    total_steps = steps * count
+    done = 0
+
+    def on_progress(idx, step, total, elapsed):
+        nonlocal done
+        done = idx * steps + step
+        pct = 2 + int(96 * done / max(1, total_steps))
+        progressbar(async_task, min(99, pct), f"NPU step {step}/{total}, image {idx + 1}/{count} ...")
+
+    try:
+        results = npu_client.generate(
+            prompt=prompt,
+            negative=negative,
+            steps=steps,
+            cfg=cfg,
+            seed=seed,
+            count=count,
+            disable_seed_increment=disable_inc,
+            on_progress=on_progress,
+            timeout=3600,
+            width=width,
+            height=height,
+        )
+    except Exception as e:
+        print(f"[npu-bridge] generation failed: {e}")
+        progressbar(async_task, 100, f"NPU generation failed: {e}")
+        stop_processing(async_task, preparation_start_time)
+        return
+
+    metadata = [
+        ('Prompt', 'prompt', prompt),
+        ('Negative Prompt', 'negative_prompt', negative),
+        ('Backend', 'backend', 'SD 2.1 on Hexagon NPU (QNN, w8a16)' if backend == 'sd21'
+         else 'SDXL Lightning on Hexagon NPU (QNN, w8a16)'),
+        ('Performance', 'performance', f'npu-{backend}'),
+        ('Steps', 'steps', steps),
+        ('Resolution', 'resolution', str((width, height))),
+        ('Guidance Scale', 'guidance_scale', cfg),
+        ('Seed', 'seed', seed),
+        ('Base Model', 'base_model', 'stable_diffusion_v2_1 (NPU)' if backend == 'sd21'
+         else 'dreamshaper-xl-lightning (NPU)'),
+    ]
+
+    for idx, (res_seed, arr) in enumerate(results):
+        progressbar(async_task, min(99, 2 + int(96 * (idx + 1) * steps / max(1, total_steps))),
+                    f"Saving image {idx + 1}/{count} ...")
+        try:
+            path = log(
+                arr,
+                metadata,
+                output_format=getattr(async_task, "output_format", None),
+                task={'positive': [prompt], 'negative': [negative]},
+                persist_image=True,
+            )
+        except Exception as e:
+            print(f"[npu-bridge] log failed: {e}")
+            # Fall back to a temp filename-less save via PIL.
+            path = None
+        if path is not None:
+            try:
+                yield_result(async_task, path, 100, getattr(async_task, "black_out_nsfw", False), True)
+            except Exception as e:
+                print(f"[npu-bridge] yield_result failed: {e}")
+        # Keep arr reference alive for the duration (no-op).
+        _ = np.asarray(arr)
+
+    progressbar(async_task, 100, "Finished NPU generation.")
+    stop_processing(async_task, preparation_start_time)
diff --git a/modules/resource_monitor.py b/modules/resource_monitor.py
new file mode 100644
index 0000000..bfef04e
--- /dev/null
+++ b/modules/resource_monitor.py
@@ -0,0 +1,281 @@
+"""Live resource meter for the Fooocus UI.
+
+Serves a tiny same-origin iframe that polls /resource-metrics every two seconds:
+system and process memory, the accelerator actually serving requests, and the
+model family (SDXL, SD 2.1, SD 1.5).
+
+The page is deliberately independent of Gradio's event queue. A `load(...,
+every=2)` event would run an infinite generator inside a queue worker and either
+block generation or force concurrent generation workers.
+"""
+import os
+import time
+
+import psutil
+
+METER_PATH = "/resource-meter"
+METRICS_PATH = "/resource-metrics"
+
+
+def _gib(value):
+    return value / (1024.0 ** 3)
+
+
+def _paths():
+    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    parent = os.path.dirname(repo)
+    return os.environ.get("FOOOCUS_NPU_MODEL") or os.path.join(parent, "sd_xl_npu")
+
+
+def _bridge():
+    try:
+        import modules.npu_bridge as bridge
+        return bridge
+    except Exception:
+        return None
+
+
+def _health(bridge):
+    if bridge is None:
+        return False, None
+    try:
+        return bridge.npu_client._health(timeout=0.5)
+    except Exception:
+        return False, None
+
+
+def _mem_bytes(proc):
+    info = proc.memory_info()
+    return getattr(info, "private", info.rss)
+
+
+_npu_proc = None
+_npu_scan_at = 0.0
+
+
+def _npu_server_rss(healthy):
+    """Private commit of the ARM64 server, cached; rescans are throttled."""
+    global _npu_proc, _npu_scan_at
+
+    if not healthy:
+        _npu_proc = None
+        return 0
+    if _npu_proc is not None:
+        try:
+            return _mem_bytes(_npu_proc)
+        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
+            _npu_proc = None
+
+    now = time.time()
+    if now - _npu_scan_at < 10.0:
+        return 0
+    _npu_scan_at = now
+
+    found = None
+    for pid in psutil.pids():
+        try:
+            proc = psutil.Process(pid)
+            if proc.name().lower() != "python.exe":
+                continue
+            cmd = proc.cmdline()
+            if any(str(part).replace("\\", "/").lower().endswith("/npu/server.py") for part in cmd):
+                if found is None or _mem_bytes(proc) > _mem_bytes(found):
+                    found = proc
+        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
+            continue
+    if found is not None:
+        _npu_proc = found
+        return _mem_bytes(found)
+    return 0
+
+
+def _model_label(bridge, info):
+    backend = (info or {}).get("backend")
+    if backend == "sdxl":
+        return "SDXL", "DreamShaper XL Lightning", "NPU"
+    if backend == "sd21":
+        return "SD 2.1", "Qualcomm AI Hub", "NPU"
+
+    if bridge is not None and bridge.enabled():
+        model = _paths()
+        if (os.path.isdir(os.path.join(model, "unet_w8a16_quantized"))
+                or os.path.isdir(os.path.join(model, "unet"))):
+            return "SDXL", "DreamShaper XL Lightning", "NPU (idle)"
+        if os.path.isfile(os.path.join(model, "metadata.json")):
+            return "SD 2.1", "Qualcomm AI Hub", "NPU (idle)"
+        return "unknown", os.path.basename(model) or "no model dir", "NPU"
+
+    try:
+        import modules.config as config
+        name = str(getattr(config, "default_base_model_name", "") or "")
+    except Exception:
+        name = ""
+    low = name.lower()
+    if "xl" in low:
+        return "SDXL", name, "CPU"
+    if "sd15" in low or "1.5" in low or "v1-5" in low:
+        return "SD 1.5", name, "CPU"
+    return ("CPU model", name, "CPU") if name else ("unknown", "", "CPU")
+
+
+def _accelerator(bridge, healthy, info):
+    if bridge is None or not bridge.enabled():
+        return "CPU (PyTorch)", "#94a3b8"
+    try:
+        last = bridge.last_backend()
+    except Exception:
+        last = None
+    if last == "CPU":
+        return "CPU (fallback task)", "#f59e0b"
+    if healthy:
+        backend = (info or {}).get("backend", "")
+        return (f"Hexagon NPU ({backend})" if backend else "Hexagon NPU"), "#22c55e"
+    return "Hexagon NPU (idle)", "#f59e0b"
+
+
+def _quant_label(bridge):
+    """Weight/activation precision of the active backend."""
+    if bridge is None or not bridge.enabled():
+        return "fp32 (CPU pipeline)"
+
+    model = _paths()
+    if os.path.isdir(os.path.join(model, "unet_w8a16_quantized")):
+        return "w8a16 UNet / fp16 CLIP+VAE"
+    try:
+        for name in sorted(os.listdir(model)):
+            full = os.path.join(model, name)
+            if name.startswith("unet_w") and os.path.isdir(full):
+                tag = name[len("unet_"):].replace("_quantized", "")
+                return f"{tag} UNet / fp16 CLIP+VAE"
+    except Exception:
+        pass
+    if os.path.isdir(os.path.join(model, "unet")):
+        return "fp16 UNet / fp16 CLIP+VAE"
+    if os.path.isfile(os.path.join(model, "metadata.json")):
+        return "w8a16 (AI Hub)"
+    return "unknown"
+
+
+def snapshot():
+    bridge = _bridge()
+    healthy, info = _health(bridge)
+    accel, dot = _accelerator(bridge, healthy, info)
+    family, detail, source = _model_label(bridge, info)
+    quant = _quant_label(bridge)
+
+    vm = psutil.virtual_memory()
+    used = vm.total - vm.available
+    pct = round(100.0 * used / vm.total) if vm.total else 0
+    return {
+        "accel": accel,
+        "dot": dot,
+        "family": family,
+        "detail": detail,
+        "source": source,
+        "quant": quant,
+        "ram_used": round(_gib(used), 1),
+        "ram_total": round(_gib(vm.total), 1),
+        "ram_pct": pct,
+        "ram_color": "#22c55e" if pct < 70 else ("#f59e0b" if pct < 85 else "#ef4444"),
+        "ui_gb": round(_gib(_mem_bytes(psutil.Process())), 2),
+        "npu_gb": round(_gib(_npu_server_rss(healthy)), 2),
+        "updated": time.strftime("%H:%M:%S"),
+    }
+
+
+def snapshot_html():
+    """Standalone HTML snippet (used as the iframe fallback text)."""
+    try:
+        d = snapshot()
+        detail = f' <span style="opacity:.65">{d["detail"]}</span>' if d["detail"] else ""
+        return (
+            '<div style="font:12px/1.7 system-ui,Segoe UI,sans-serif;opacity:.9;">'
+            f'<b>Accelerator</b> {d["accel"]} &nbsp; <b>Model</b> {d["family"]}{detail}'
+            f' &nbsp; <b>Quant</b> {d["quant"]}'
+            f' &nbsp; <b>RAM</b> {d["ram_used"]} / {d["ram_total"]} GB ({d["ram_pct"]}%)'
+            f' &nbsp; <b>UI</b> {d["ui_gb"]:.2f} GB &nbsp; <b>NPU server</b> {d["npu_gb"]:.2f} GB'
+            '</div>'
+        )
+    except Exception as exc:
+        return f'<div style="font:12px system-ui">resource meter unavailable ({type(exc).__name__})</div>'
+
+
+_PAGE = """<!doctype html>
+<html><head><meta charset="utf-8"><style>
+html,body{margin:0;padding:0;background:transparent;overflow:hidden;
+  font:12px/1.7 system-ui,"Segoe UI",sans-serif;color:#64748b;}
+@media (prefers-color-scheme: dark){body{color:#cbd5e1}}
+#m{display:flex;flex-wrap:wrap;align-items:center;gap:2px 16px;white-space:nowrap;}
+b{font-weight:600;opacity:.78}
+.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;}
+.bar{display:inline-block;width:70px;height:5px;border-radius:3px;
+  background:rgba(148,163,184,.3);vertical-align:middle;margin-left:6px;}
+.bar>i{display:block;height:5px;border-radius:3px;}
+.muted{opacity:.55}
+</style></head><body>
+<div id="m">resource meter…</div>
+<script>
+function esc(s){return String(s).replace(/[&<>"]/g,function(c){
+  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
+function render(d){
+  var detail = d.detail ? ' <span class="muted">'+esc(d.detail)+'</span>' : '';
+  var bar = '<span class="bar"><i style="width:'+d.ram_pct+'%;background:'+d.ram_color+'"></i></span>';
+  document.getElementById('m').innerHTML =
+    '<span><span class="dot" style="background:'+d.dot+'"></span><b>Accelerator</b> '+esc(d.accel)+'</span>'+
+    '<span><b>Model</b> '+esc(d.family)+detail+' <span class="muted">('+esc(d.source)+')</span></span>'+
+    '<span><b>Quant</b> '+esc(d.quant)+'</span>'+
+    '<span><b>RAM</b> '+d.ram_used+' / '+d.ram_total+' GB ('+d.ram_pct+'%)'+bar+'</span>'+
+    '<span><b>UI</b> '+d.ui_gb.toFixed(2)+' GB</span>'+
+    '<span><b>NPU server</b> '+d.npu_gb.toFixed(2)+' GB</span>'+
+    '<span class="muted">updated '+esc(d.updated)+'</span>';
+}
+async function tick(){
+  try{
+    var r = await fetch('/resource-metrics', {cache:'no-store'});
+    if(!r.ok) throw new Error(r.status);
+    render(await r.json());
+  }catch(e){
+    document.getElementById('m').textContent = 'resource meter offline';
+  }
+}
+tick(); setInterval(tick, 2000);
+</script></body></html>
+"""
+
+
+def meter_iframe(height=30):
+    return (
+        f'<iframe src="{METER_PATH}" title="resource meter" scrolling="no" '
+        f'style="width:100%;height:{height}px;border:0;background:transparent;display:block;">'
+        '</iframe>'
+    )
+
+
+def install_routes():
+    """Add /resource-meter and /resource-metrics to Gradio's FastAPI app."""
+    try:
+        import gradio.networking as networking
+        from fastapi.responses import HTMLResponse, JSONResponse
+    except Exception:
+        return False
+    if getattr(networking, "_fooocus_resource_meter", False):
+        return True
+
+    original = networking.start_server
+
+    def start_server(*args, **kwargs):
+        server_name, server_port, local_url, app, server = original(*args, **kwargs)
+
+        @app.get(METRICS_PATH)
+        def _resource_metrics():
+            return JSONResponse(snapshot(), headers={"Cache-Control": "no-store"})
+
+        @app.get(METER_PATH, response_class=HTMLResponse)
+        def _resource_meter():
+            return HTMLResponse(_PAGE, headers={"Cache-Control": "no-store"})
+
+        return server_name, server_port, local_url, app, server
+
+    networking.start_server = start_server
+    networking._fooocus_resource_meter = True
+    return True
