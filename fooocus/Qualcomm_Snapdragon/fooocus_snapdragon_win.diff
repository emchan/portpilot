+# ---------------------------------------------------------------------
+# NPU backend for Fooocus: ONNX Runtime QNN (Hexagon HTP).
+#
+# Runs Qualcomm AI Hub's precompiled Stable Diffusion 2.1 graphs
+# (text_encoder, unet, vae; w8a16) on the Snapdragon NPU.
+#
+# The QNN boundary helpers and the Euler scheduler are adapted from
+# Qualcomm's ai-hub-apps `stable_diffusion_windows_py` sample
+# (BSD-3-Clause, Copyright (c) Qualcomm Technologies, Inc.).
+# ---------------------------------------------------------------------
+from __future__ import annotations
+
+import json
+import os
+import time
+from dataclasses import dataclass
+
+import numpy as np
+import onnxruntime as ort
+
+try:  # onnxruntime-qnn >= 2.0.0 ships the EP as a plugin package
+    import onnxruntime_qnn as qnn
+except ImportError:  # classic EP build
+    qnn = None
+
+_ORT_TO_NP = {
+    "tensor(float)": np.float32,
+    "tensor(float16)": np.float16,
+    "tensor(double)": np.float64,
+    "tensor(int32)": np.int32,
+    "tensor(int64)": np.int64,
+    "tensor(uint16)": np.uint16,
+    "tensor(uint8)": np.uint8,
+}
+
+_QNN_OPTIONS = {
+    "enable_htp_fp16_precision": "1",
+    "htp_performance_mode": "burst",
+    "htp_graph_finalization_optimization_mode": "3",
+    "offload_graph_io_quantization": "1",
+}
+
+
+def _open_session(path: str) -> ort.InferenceSession:
+    so = ort.SessionOptions()
+    so.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
+    if qnn is not None:
+        if not getattr(_open_session, "_registered", False):
+            try:
+                ort.register_execution_provider_library(qnn.EP_NAME, qnn.get_library_path())
+            except Exception:
+                # Another backend (e.g. the SDXL engine) registered it first.
+                pass
+            _open_session._registered = True
+        devices = [d for d in ort.get_ep_devices() if d.ep_name == qnn.EP_NAME]
+        so.add_provider_for_devices(devices, _QNN_OPTIONS)
+        return ort.InferenceSession(path, sess_options=so)
+    return ort.InferenceSession(
+        path,
+        sess_options=so,
+        providers=["QNNExecutionProvider"],
+        provider_options=[{**_QNN_OPTIONS, "backend_path": "QnnHtp.dll"}],
+    )
+
+
+@dataclass
+class _Boundary:
+    name: str
+    dtype: type
+    scale: float | None = None
+    zero_point: int | None = None
+
+    def feed(self, value: np.ndarray) -> np.ndarray:
+        if self.scale is None:
+            return value.astype(self.dtype, copy=False)
+        q = np.rint(value.astype(np.float64) / self.scale) + self.zero_point
+        info = np.iinfo(self.dtype)
+        return np.clip(q, info.min, info.max).astype(self.dtype)
+
+    def read(self, value: np.ndarray) -> np.ndarray:
+        if self.scale is None:
+            return value
+        return ((value.astype(np.int32) - self.zero_point) * self.scale).astype(np.float32)
+
+
+class QuantizedGraph:
+    """A QNN-accelerated ONNX graph with metadata-driven (de)quantization."""
+
+    def __init__(self, onnx_path: str, meta: dict) -> None:
+        self.path = onnx_path
+        self.session = _open_session(onnx_path)
+        self.inputs = [
+            self._boundary(i.name, _ORT_TO_NP[i.type], meta.get("inputs", {}).get(i.name))
+            for i in self.session.get_inputs()
+        ]
+        self.outputs = [
+            self._boundary(o.name, _ORT_TO_NP[o.type], meta.get("outputs", {}).get(o.name))
+            for o in self.session.get_outputs()
+        ]
+
+    @staticmethod
+    def _boundary(name, dtype, spec) -> _Boundary:
+        if spec and "quantization_parameters" in spec:
+            q = spec["quantization_parameters"]
+            return _Boundary(name, dtype, float(q["scale"]), int(q["zero_point"]))
+        return _Boundary(name, dtype)
+
+    def run(self, **values: np.ndarray) -> np.ndarray:
+        feed = {b.name: b.feed(values[b.name]) for b in self.inputs if b.name in values}
+        missing = [b.name for b in self.inputs if b.name not in values]
+        if missing:
+            raise ValueError(f"missing inputs for {os.path.basename(self.path)}: {missing}")
+        # Preserve graph input order rather than caller (kwargs) order.
+        feed = {b.name: feed[b.name] for b in self.inputs}
+        out = self.session.run([b.name for b in self.outputs], feed)
+        return {b.name: b.read(v) for b, v in zip(self.outputs, out)}
+
+
+class EulerScheduler:
+    """diffusers EulerDiscreteScheduler equivalent used by SD 2.1 (v_prediction)."""
+
+    BETA_START = 0.00085
+    BETA_END = 0.012
+    NUM_TRAIN_TIMESTEPS = 1000
+    STEPS_OFFSET = 1
+
+    def __init__(self, num_steps: int) -> None:
+        betas = np.linspace(self.BETA_START**0.5, self.BETA_END**0.5, self.NUM_TRAIN_TIMESTEPS) ** 2
+        alphas_cumprod = np.cumprod(1.0 - betas)
+        all_sigmas = ((1 - alphas_cumprod) / alphas_cumprod) ** 0.5
+        step_ratio = self.NUM_TRAIN_TIMESTEPS / num_steps
+        ts = (np.arange(0, num_steps) * step_ratio).round().astype(np.int64)
+        ts += self.STEPS_OFFSET
+        self.timesteps = ts[::-1].copy()
+        self.sigmas = np.append(all_sigmas[self.timesteps], 0.0)
+        self.num_steps = num_steps
+
+    @property
+    def init_noise_sigma(self) -> float:
+        return float(self.sigmas.max())
+
+    def scale_model_input(self, sample: np.ndarray, step_index: int) -> np.ndarray:
+        sigma = float(self.sigmas[step_index])
+        return sample / float((sigma**2 + 1) ** 0.5)
+
+    def step(self, model_output: np.ndarray, step_index: int, sample: np.ndarray) -> np.ndarray:
+        sigma = float(self.sigmas[step_index])
+        sigma_next = float(self.sigmas[step_index + 1])
+        pred_orig = model_output * float(-sigma / (sigma**2 + 1) ** 0.5) + sample * float(1.0 / (sigma**2 + 1))
+        derivative = (sample - pred_orig) / sigma
+        return sample + derivative * float(sigma_next - sigma)
+
+
+class NpuPipeline:
+    """Stable Diffusion 2.1 text-to-image on the Hexagon NPU (512x512)."""
+
+    SIZE = 512
+    SUPPORTED_SIZES = [(512, 512)]
+    LATENT = 64
+    MAX_TOKENS = 77
+
+    def __init__(self, model_dir: str, tokenizer_dir: str | None = None, tokenizer_repo: str | None = None) -> None:
+        self.model_dir = model_dir
+        meta_path = os.path.join(model_dir, "metadata.json")
+        meta = json.load(open(meta_path, encoding="utf-8")) if os.path.exists(meta_path) else {}
+        self.text_encoder = QuantizedGraph(os.path.join(model_dir, "text_encoder.onnx"), meta.get("model_files", {}).get("text_encoder.onnx", {}))
+        self.unet = QuantizedGraph(os.path.join(model_dir, "unet.onnx"), meta.get("model_files", {}).get("unet.onnx", {}))
+        self.vae = QuantizedGraph(os.path.join(model_dir, "vae.onnx"), meta.get("model_files", {}).get("vae.onnx", {}))
+        self.meta = meta
+
+        from transformers import CLIPTokenizer
+
+        if tokenizer_dir and os.path.isdir(tokenizer_dir):
+            self.tokenizer = CLIPTokenizer.from_pretrained(tokenizer_dir)
+        else:
+            self.tokenizer = CLIPTokenizer.from_pretrained(tokenizer_repo or "sd2-community/stable-diffusion-2-1", subfolder="tokenizer")
+
+    # -- text ---------------------------------------------------------
+    def _tokens(self, text: str) -> np.ndarray:
+        out = self.tokenizer(
+            text,
+            padding="max_length",
+            max_length=self.MAX_TOKENS,
+            truncation=True,
+            return_tensors="np",
+        )
+        return out.input_ids.astype(np.int32)
+
+    def encode(self, prompt: str, negative: str = "") -> tuple[np.ndarray, np.ndarray]:
+        cond = self.text_encoder.run(tokens=self._tokens(prompt))["text_embedding"]
+        uncond = self.text_encoder.run(tokens=self._tokens(negative or ""))["text_embedding"]
+        return cond, uncond
+
+    # -- diffusion ----------------------------------------------------
+    def generate(
+        self,
+        prompt: str,
+        negative: str = "",
+        steps: int = 20,
+        cfg: float = 7.5,
+        seed: int = 47,
+        on_step=None,
+        width: int = 512,
+        height: int = 512,
+    ) -> np.ndarray:
+        steps = max(1, min(int(steps), 60))
+        t_start = time.perf_counter()
+        cond, uncond = self.encode(prompt, negative)
+        if on_step:
+            on_step(0, steps, time.perf_counter() - t_start)
+
+        scheduler = EulerScheduler(steps)
+        latents = np.random.default_rng(int(seed)).standard_normal((1, 4, self.LATENT, self.LATENT)).astype(np.float32)
+        latents *= scheduler.init_noise_sigma
+
+        for i, t in enumerate(scheduler.timesteps):
+            time_input = np.array([[t]], dtype=np.float32)
+            latent_input = np.transpose(scheduler.scale_model_input(latents, i), (0, 2, 3, 1)).astype(np.float32)
+
+            noise_cond = self.unet.run(timestep=time_input, latent=latent_input, text_emb=cond)["output_latent"]
+            noise_uncond = self.unet.run(timestep=time_input, latent=latent_input, text_emb=uncond)["output_latent"]
+            noise_pred = noise_uncond + cfg * (noise_cond - noise_uncond)
+
+            latents = scheduler.step(np.transpose(noise_pred, (0, 3, 1, 2)), i, latents)
+            if on_step:
+                on_step(i + 1, steps, time.perf_counter() - t_start)
+
+        image = self.vae.run(latent=np.transpose(latents, (0, 2, 3, 1)).astype(np.float32))["image"]
+        image = np.clip(image[0], 0.0, 1.0)
+        return (image * 255.0 + 0.5).astype(np.uint8)
