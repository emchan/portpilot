+++ b/npu/sdxl/prof.py
@@ -0,0 +1,41 @@
+"""No-op profiler shim (the upstream project profiles via psutil)."""
+
+
+class _NullProfiler:
+    events = []
+    recorded_times = {}
+
+    def start_profile(self, *a, **k):
+        pass
+
+    def stop_profile(self, *a, **k):
+        pass
+
+    def destroy_profile_event(self, *a, **k):
+        pass
+
+    def exists(self, *a, **k):
+        return False
+
+    def event_elapsed_time(self, *a, **k):
+        return 0.0
+
+
+def register(name):
+    return _NullProfiler()
+
+
+def get(name):
+    return _NullProfiler()
+
+
+def get_current_memory_info():
+    return (0.0, 0.0, 0.0, 0.0)
+
+
+def get_peak_memory_gb():
+    return 0.0
+
+
+def get_summary(*a, **k):
+    return ""
