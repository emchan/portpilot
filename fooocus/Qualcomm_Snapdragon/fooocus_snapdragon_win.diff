+++ b/npu/sdxl/tokenizer.py
@@ -0,0 +1,24 @@
+"""CLIP tokenizer backed by transformers (drops the ONNX tokenizer custom ops)."""
+import os
+
+import numpy as np
+from transformers import CLIPTokenizer
+
+
+class Tokenizer:
+    def __init__(self, tokenizer_path):
+        if tokenizer_path.endswith(".onnx"):
+            tokenizer_path = os.path.dirname(tokenizer_path)
+        self.tokenizer = CLIPTokenizer.from_pretrained(tokenizer_path)
+
+    def run(self, prompt, auto_mem_free=True, padding=49407):
+        enc = self.tokenizer(prompt, truncation=True, max_length=77, return_tensors="np")
+        ids = enc.input_ids[0].astype(np.int32)
+        if len(ids) >= 77:
+            ids[76] = 49407
+        ids = ids[:77]
+        ids = np.pad(ids, (0, 77 - len(ids)), mode="constant", constant_values=(0, padding))
+        return [ids]
+
+    def free_memory(self):
+        pass
