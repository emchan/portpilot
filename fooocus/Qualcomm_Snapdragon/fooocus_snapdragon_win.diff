+# ---------------------------------------------------------------------
+# SDXL (DreamShaper XL Lightning) on the Hexagon NPU.
+#
+# Wraps the vendored SDXL QNN pipeline (Fooocus/npu/sdxl, MIT license,
+# Copyright (c) 2026 buuta-buta-butaata) and exposes the same interface
+# as the SD 2.1 NpuPipeline: generate(...) -> HWC uint8 image.
+# ---------------------------------------------------------------------
+import os
+import time
+import types
+
+import numpy as np
+import onnxruntime as ort
+
+try:
+    from .sdxl.pipeline import SDXLPipeline
+    from .sdxl.text_processing import TextProcessing
+    from .sdxl.unet import UNet
+    from .sdxl.vae_decoder import VAEDecoder
+    from .sdxl.scheduler_numpy import Scheduler
+    from .sdxl import qnn_ep
+except ImportError:  # imported as a top-level module by server.py
+    from sdxl.pipeline import SDXLPipeline
+    from sdxl.text_processing import TextProcessing
+    from sdxl.unet import UNet
+    from sdxl.vae_decoder import VAEDecoder
+    from sdxl.scheduler_numpy import Scheduler
+    from sdxl import qnn_ep
+
+SCALING_FACTOR = 0.13025
+
+
+class _VaeEncoder:
+    """QNN VAE encoder (input 3x1024x1024, output 8ch mean+logvar)."""
+
+    def __init__(self, path):
+        self.session = ort.InferenceSession(path, sess_options=qnn_ep.session_options)
+        self.input = self.session.get_inputs()[0]
+        self.dtype = np.float16 if "float16" in self.input.type else np.float32
+
+    def encode(self, pixels_nchw):
+        out = self.session.run(None, {self.input.name: pixels_nchw.astype(self.dtype)})[0]
+        return out.astype(np.float32)
+
+
+class _CapturePipeline(SDXLPipeline):
+    """SDXLPipeline that returns the decoded image instead of saving it."""
+
+    def output_image(self, image_np):
+        self.last_image = image_np
+
+
+class SdxlPipeline:
+    SIZE = 1024
+    SUPPORTED_SIZES = [(1024, 1024)]
+
+    def __init__(self, model_dir, output_dir=None):
+        self.model_dir = model_dir
+        self.output_dir = output_dir or os.path.join(os.path.dirname(os.path.abspath(__file__)), "sdxl_out")
+        os.makedirs(self.output_dir, exist_ok=True)
+
+        quantized = os.path.isdir(os.path.join(model_dir, "unet_w8a16_quantized"))
+        unet_dir = os.path.join(model_dir, "unet_w8a16_quantized" if quantized else "unet")
+        if not os.path.isdir(unet_dir):
+            raise FileNotFoundError(f"no UNet directory under {model_dir}")
+
+        self.config = types.SimpleNamespace(
+            prompt="",
+            prompt_2="",
+            negative_prompt="",
+            negative_prompt_2="",
+            steps=6,
+            seed=42,
+            cfg=2.0,
+            width=1024,
+            height=1024,
+            quantized_model=quantized,
+            weight_shared_model=False,
+            use_legacy_model=False,
+            unet_fp16=["part0"],
+            use_torch=False,
+            scheduler_type=0,
+            scheduler_config={},
+            t2i_mode=None,
+            debug_mode=False,
+            profile=False,
+            output_prefix="npu_",
+            on_step=None,
+            dirs={
+                "text_encoder_dir": os.path.join(model_dir, "text_encoder"),
+                "text_encoder_2_dir": os.path.join(model_dir, "text_encoder_2"),
+                "tokenizer_dir": os.path.join(model_dir, "tokenizer"),
+                "tokenizer_2_dir": os.path.join(model_dir, "tokenizer_2"),
+                "unet_dir": unet_dir,
+                "unet_dir_fp16": os.path.join(model_dir, "unet") if os.path.isdir(
+                    os.path.join(model_dir, "unet")) else unet_dir,
+                "vae_decoder_dir": os.path.join(model_dir, "vae_decoder"),
+                "vae_encoder_dir": os.path.join(model_dir, "vae_encoder"),
+                "output_dir": self.output_dir,
+            },
+        )
+        self.impl = _CapturePipeline(self.config)
+        self._vae_encoder = None
+
+    def generate(self, prompt, negative="", steps=6, cfg=2.0, seed=42,
+                 width=1024, height=1024, on_step=None):
+        steps = max(1, min(int(steps), 50))
+        if (int(width), int(height)) not in self.SUPPORTED_SIZES:
+            width, height = self.SIZE, self.SIZE
+
+        c = self.config
+        c.prompt = prompt
+        c.prompt_2 = prompt
+        c.negative_prompt = negative or ""
+        c.negative_prompt_2 = negative or ""
+        c.steps = steps
+        c.cfg = float(cfg)
+        c.seed = int(seed) & 0xFFFFFFFF
+        c.width = int(width)
+        c.height = int(height)
+        c.scheduler_config = {}
+        c.on_step = on_step
+
+        t0 = time.perf_counter()
+        self.impl.run()
+        img = getattr(self.impl, "last_image", None)
+        if img is None:
+            raise RuntimeError("SDXL pipeline produced no image")
+        # (1, 3, H, W) in [-1, 1] -> HWC uint8
+        arr = ((np.asarray(img, dtype=np.float32) / 2.0 + 0.5).clip(0, 1) * 255.0 + 0.5).astype(np.uint8)
+        arr = arr[0].transpose(1, 2, 0)
+        return arr
+
+    # ------------------------------------------------------------------
+    # Inpainting (masked-latent blending, no Fooocus inpaint head)
+    # ------------------------------------------------------------------
+    def _ensure_text(self):
+        if self.impl.text_processing is None:
+            d = self.config.dirs
+            self.impl.text_processing = TextProcessing(
+                d["text_encoder_dir"], d["tokenizer_dir"],
+                d["text_encoder_2_dir"], d["tokenizer_2_dir"], False)
+        return self.impl.text_processing
+
+    def _ensure_unet(self):
+        if self.impl.unet is None:
+            self.impl.unet = UNet(self.config)
+            self.impl.unet.load_models(self.config)
+        return self.impl.unet
+
+    def _ensure_decoder(self):
+        if self.impl.vae_decoder is None:
+            self.impl.vae_decoder = VAEDecoder(self.config)
+        return self.impl.vae_decoder
+
+    def _ensure_encoder(self):
+        if self._vae_encoder is None:
+            p = os.path.join(self.model_dir, "vae_encoder", f"{self.SIZE}x{self.SIZE}", "model.onnx")
+            if not os.path.exists(p):
+                p = os.path.join(self.model_dir, "vae_encoder", "model.onnx")
+            if not os.path.exists(p):
+                raise FileNotFoundError("no VAE encoder (download vae_encoder/1024x1024)")
+            self._vae_encoder = _VaeEncoder(p)
+        return self._vae_encoder
+
+    @staticmethod
+    def _to_mask_latent(mask, size, lat):
+        from PIL import Image
+
+        m = np.asarray(Image.fromarray(mask.astype(np.uint8), mode="L").resize((size, size), Image.BILINEAR),
+                       dtype=np.float32) / 255.0
+        m = (m > 0.5).astype(np.float32)
+        return m.reshape(lat, 8, lat, 8).max(axis=(1, 3))[None, None]
+
+    def inpaint(self, fill_rgb, mask_l, prompt, negative="", steps=8, cfg=2.0,
+                seed=42, strength=1.0, on_step=None):
+        from PIL import Image
+
+        steps = max(1, min(int(steps), 50))
+        strength = float(min(max(float(strength), 0.05), 1.0))
+
+        c = self.config
+        c.prompt = prompt
+        c.prompt_2 = prompt
+        c.negative_prompt = negative or ""
+        c.negative_prompt_2 = negative or ""
+        c.steps = steps
+        c.cfg = float(cfg)
+        c.seed = int(seed) & 0xFFFFFFFF
+        c.width = c.height = self.SIZE
+        c.scheduler_config = {}
+        c.on_step = None
+
+        text = self._ensure_text()
+        cond, pooled, uncond, uncond_pooled = text.encode_text(
+            prompt, prompt, negative or "", negative or "", c, False)
+
+        unet = self._ensure_unet()
+        unet.run_adapters(c)
+        decoder = self._ensure_decoder()
+        encoder = self._ensure_encoder()
+
+        # Fill image -> VAE latent (model space: * SCALING_FACTOR)
+        fill = np.asarray(fill_rgb, dtype=np.uint8)
+        if fill.shape[0] != self.SIZE or fill.shape[1] != self.SIZE:
+            fill = np.asarray(Image.fromarray(fill).resize((self.SIZE, self.SIZE), Image.LANCZOS))
+        pixels = (fill.astype(np.float32) / 127.5 - 1.0).transpose(2, 0, 1)[None]
+        moments = encoder.encode(pixels)
+        latent_fill = moments[:, :4] * SCALING_FACTOR
+
+        lat = self.SIZE // 8
+        mask = self._to_mask_latent(np.asarray(mask_l), self.SIZE, lat)
+
+        sched = Scheduler(0, int(seed))
+        if strength > 0.9999:
+            sched.set_timesteps(steps)
+            sigmas = np.asarray(sched.scheduler.sigmas, dtype=np.float32)
+            timesteps = np.asarray(sched.scheduler.timesteps, dtype=np.float32)
+        else:
+            new_steps = max(1, int(steps / strength))
+            sched.set_timesteps(new_steps)
+            sigmas = np.asarray(sched.scheduler.sigmas, dtype=np.float32)[-(steps + 1):]
+            timesteps = np.asarray(sched.scheduler.timesteps, dtype=np.float32)[-steps:]
+
+        rng = np.random.default_rng(int(seed) & 0xFFFFFFFF)
+        latents = rng.standard_normal(latent_fill.shape).astype(np.float32) * float(sigmas[0])
+
+        timestep_dtype = getattr(unet, "part0_type", np.float16)
+        time_ids = np.array([[self.SIZE, self.SIZE, 0, 0, self.SIZE, self.SIZE]], dtype=timestep_dtype)
+        base = {"text_embeds": np.asarray(pooled, dtype=timestep_dtype), "time_ids": time_ids}
+        embeds = np.asarray(cond, dtype=np.float16)
+        if uncond is not None:
+            base_u = {"text_embeds": np.asarray(uncond_pooled, dtype=timestep_dtype), "time_ids": time_ids}
+            embeds_u = np.asarray(uncond, dtype=np.float16)
+
+        cfg = float(cfg)
+        for i in range(len(timesteps)):
+            sigma = float(sigmas[i])
+            sigma_next = float(sigmas[i + 1])
+
+            energy = rng.standard_normal(latents.shape).astype(np.float32) * sigma
+            x = latents * mask + (latent_fill + energy) * (1.0 - mask)
+            scaled = (x / np.sqrt(sigma * sigma + 1.0)).astype(np.float16)
+            t = np.array([timesteps[i]], dtype=np.float32).astype(timestep_dtype)
+
+            cond_out = unet.forward(scaled, t, base, embeds, step=i)[0].astype(np.float32)
+            if uncond is not None:
+                uncond_out = unet.forward(scaled, t, base_u, embeds_u, step=i, is_uncond=True)[0].astype(np.float32)
+                noise_pred = uncond_out + cfg * (cond_out - uncond_out)
+            else:
+                noise_pred = cond_out
+
+            out = noise_pred * mask + latent_fill * (1.0 - mask)
+
+            # Euler ancestral step (prediction type from the scheduler config)
+            pred_type = getattr(sched.config, "prediction_type", "epsilon")
+            if pred_type == "v_prediction":
+                pred_orig = out * (-sigma / np.sqrt(sigma * sigma + 1.0)) + x / (sigma * sigma + 1.0)
+            else:
+                pred_orig = x - sigma * out
+            derivative = (x - pred_orig) / sigma
+            if sigma_next > 0:
+                sigma_up = min(sigma_next, float(np.sqrt(max(
+                    sigma_next ** 2 * (sigma ** 2 - sigma_next ** 2) / max(sigma ** 2, 1e-12), 0.0))))
+                sigma_down = float(np.sqrt(max(sigma_next ** 2 - sigma_up ** 2, 0.0)))
+            else:
+                sigma_up, sigma_down = 0.0, 0.0
+            latents = x + derivative * (sigma_down - sigma)
+            if sigma_up > 0:
+                latents = latents + rng.standard_normal(latents.shape).astype(np.float32) * sigma_up
+
+            if on_step is not None:
+                on_step(i + 1, len(timesteps))
+
+        img = decoder.decode((latents / SCALING_FACTOR).astype(np.float16), auto_mem_free=False)
+        img = np.asarray(img, dtype=np.float32)
+        arr = ((img / 2.0 + 0.5).clip(0, 1) * 255.0 + 0.5).astype(np.uint8)[0].transpose(1, 2, 0)
+        return arr
+
