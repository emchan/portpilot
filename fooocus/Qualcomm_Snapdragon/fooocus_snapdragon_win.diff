new file mode 100644
index 0000000..c809548
--- /dev/null
+++ b/npu/server.py
@@ -0,0 +1,356 @@
+# ---------------------------------------------------------------------
+# NPU server for Fooocus: Stable Diffusion + assist models on the Hexagon NPU.
+#
+# Runs under an ARM64 Python with onnxruntime-qnn (qnn_env). Fooocus (x64)
+# talks to it over HTTP on 127.0.0.1:7867.
+#
+# Diffusion backends (auto-detected from the model directory):
+#   sd21 - Qualcomm AI Hub SD 2.1 (single-graph text_encoder/unet/vae)
+#   sdxl - DreamShaper XL Lightning, 5-part UNet (precompiled QNN)
+#
+# Assist endpoints (plain ONNX, QNN with native ARM64 CPU fallback):
+#   POST /tagger - WD14 tagger -> tag string
+#   POST /mask   - U2Net-family matting -> mask PNG
+# ---------------------------------------------------------------------
+import argparse
+import base64
+import csv
+import io
+import json
+import os
+import sys
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import numpy as np
+import onnxruntime as ort
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+if HERE not in sys.path:
+    sys.path.insert(0, HERE)
+
+from qnn_sd21 import NpuPipeline  # noqa: E402
+
+try:
+    import onnxruntime_qnn as qnn
+except ImportError:  # pragma: no cover
+    qnn = None
+
+try:
+    from qnn_sdxl import SdxlPipeline
+except Exception:  # pragma: no cover - sdxl deps optional
+    SdxlPipeline = None
+
+
+# ---------------------------------------------------------------------
+# Assist models: WD14 tagger / U2Net matting
+# ---------------------------------------------------------------------
+_assist_sessions = {}
+
+
+def _open_assist(path):
+    """Open an assist ONNX graph on QNN (NPU), falling back to native ARM64 CPU."""
+    key = os.path.abspath(path)
+    if key in _assist_sessions:
+        return _assist_sessions[key]
+
+    session = None
+    if qnn is not None:
+        try:
+            try:
+                ort.register_execution_provider_library(qnn.EP_NAME, qnn.get_library_path())
+            except Exception:
+                pass
+            devices = [d for d in ort.get_ep_devices() if d.ep_name == qnn.EP_NAME]
+            so = ort.SessionOptions()
+            so.log_severity_level = 3
+            so.add_provider_for_devices(devices, {
+                "backend_path": qnn.get_qnn_htp_path(),
+                "enable_htp_fp16_precision": "1",
+                "htp_performance_mode": "burst",
+            })
+            session = ort.InferenceSession(path, sess_options=so)
+            print(f"[npu] assist session on QNN: {os.path.basename(path)}", flush=True)
+        except Exception as e:
+            print(f"[npu] QNN assist unavailable for {os.path.basename(path)} ({e}); "
+                  f"using ARM64 CPU", flush=True)
+            session = None
+
+    if session is None:
+        so = ort.SessionOptions()
+        so.log_severity_level = 3
+        session = ort.InferenceSession(path, sess_options=so, providers=["CPUExecutionProvider"])
+
+    _assist_sessions[key] = session
+    return session
+
+
+def _run_tagger(png_bytes, model_onnx, model_csv, threshold, character_threshold, exclude_tags):
+    session = _open_assist(model_onnx)
+    inp = session.get_inputs()[0]
+    height = int(inp.shape[1])
+
+    from PIL import Image
+
+    image = Image.open(io.BytesIO(png_bytes)).convert("RGB")
+    ratio = float(height) / max(image.size)
+    new_size = tuple(int(x * ratio) for x in image.size)
+    image = image.resize(new_size, Image.LANCZOS)
+    square = Image.new("RGB", (height, height), (255, 255, 255))
+    square.paste(image, ((height - new_size[0]) // 2, (height - new_size[1]) // 2))
+
+    arr = np.asarray(square, dtype=np.float32)[:, :, ::-1]  # RGB -> BGR
+    arr = np.expand_dims(arr, 0)
+
+    rows = []
+    with open(model_csv, encoding="utf-8") as f:
+        reader = csv.reader(f)
+        next(reader)
+        for row in reader:
+            rows.append(row)
+
+    tags, general_index, character_index = [], None, None
+    for i, row in enumerate(rows):
+        if general_index is None and row[2] in ("0", 0):
+            general_index = i
+        elif character_index is None and row[2] in ("4", 4):
+            character_index = i
+        tags.append(row[1])
+
+    probs = session.run([session.get_outputs()[0].name], {inp.name: arr})[0][0]
+    result = list(zip(tags, probs))
+
+    general = [item for item in result[general_index:character_index] if item[1] > threshold]
+    character = [item for item in result[character_index:] if item[1] > character_threshold]
+    all_tags = character + general
+    remove = [s.strip() for s in (exclude_tags or "").lower().split(",")]
+    all_tags = [tag for tag in all_tags if tag[0] not in remove]
+    return ", ".join((item[0].replace("(", "\\(").replace(")", "\\)") for item in all_tags)).replace("_", " ")
+
+
+def _run_mask(png_bytes, model_path):
+    session = _open_assist(model_path)
+
+    from PIL import Image
+
+    image = Image.open(io.BytesIO(png_bytes)).convert("RGB")
+    im = np.asarray(image.resize((320, 320), Image.LANCZOS), dtype=np.float32)
+    im = im / max(float(im.max()), 1e-6)
+    mean = (0.485, 0.456, 0.406)
+    std = (0.229, 0.224, 0.225)
+    tmp = np.zeros_like(im)
+    for c in range(3):
+        tmp[:, :, c] = (im[:, :, c] - mean[c]) / std[c]
+    arr = np.expand_dims(tmp.transpose(2, 0, 1), 0).astype(np.float32)
+
+    out = session.run(None, {session.get_inputs()[0].name: arr})[0][:, 0, :, :]
+    pred = out[0]
+    mi, ma = float(pred.min()), float(pred.max())
+    pred = (pred - mi) / max(ma - mi, 1e-6)
+    mask = Image.fromarray((pred * 255).astype(np.uint8), mode="L").resize(image.size, Image.LANCZOS)
+    buf = io.BytesIO()
+    mask.save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def load_backend(model_dir, backend="auto"):
+    has_meta = os.path.exists(os.path.join(model_dir, "metadata.json"))
+    has_dirs = os.path.isdir(os.path.join(model_dir, "unet_w8a16_quantized")) or os.path.isdir(
+        os.path.join(model_dir, "unet"))
+    if backend in ("auto", "sd21") and has_meta:
+        return NpuPipeline(model_dir), "sd21"
+    if backend in ("auto", "sdxl") and has_dirs and SdxlPipeline is not None:
+        return SdxlPipeline(model_dir), "sdxl"
+    raise SystemExit(f"cannot determine backend for {model_dir} (metadata.json={has_meta}, unet dirs={has_dirs})")
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model-dir", required=True, help="model directory (SD2.1 metadata.json or SDXL assets)")
+    ap.add_argument("--backend", default="auto", choices=["auto", "sd21", "sdxl"])
+    ap.add_argument("--tokenizer-dir", default=None, help="SD2.1 only: optional local tokenizer dir")
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--port", type=int, default=7867)
+    args = ap.parse_args()
+
+    print(f"[npu] loading {args.backend} backend from {args.model_dir}", flush=True)
+    t0 = time.perf_counter()
+    if args.backend in ("auto", "sd21") and args.tokenizer_dir:
+        pipe = NpuPipeline(args.model_dir, tokenizer_dir=args.tokenizer_dir)
+        backend = "sd21"
+    else:
+        pipe, backend = load_backend(args.model_dir, args.backend)
+    print(f"[npu] {backend} ready in {time.perf_counter() - t0:.2f}s", flush=True)
+
+    sizes = list(getattr(pipe, "SUPPORTED_SIZES", [(pipe.SIZE, pipe.SIZE)]))
+    lock = threading.Lock()
+
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, fmt, *a):
+            sys.stderr.write("[npu] " + (fmt % a) + "\n")
+
+        def _read_json(self):
+            n = int(self.headers.get("Content-Length", "0"))
+            body = self.rfile.read(n) if n else b"{}"
+            return json.loads(body.decode("utf-8"))
+
+        def _send_json(self, status, obj):
+            data = json.dumps(obj).encode("utf-8")
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+            self.wfile.flush()
+
+        def do_GET(self):
+            if self.path.rstrip("/") == "/health":
+                self._send_json(200, {
+                    "ready": True,
+                    "backend": backend,
+                    "size": pipe.SIZE,
+                    "sizes": sizes,
+                    "assist": ["tagger", "mask"],
+                    "model_dir": args.model_dir,
+                })
+                return
+            self._send_json(404, {"error": "not found"})
+
+        def do_POST(self):
+            route = self.path.rstrip("/")
+            try:
+                if route == "/shutdown":
+                    self._send_json(200, {"ok": True})
+                    threading.Thread(target=self.server.shutdown, daemon=True).start()
+                    return
+                if route == "/tagger":
+                    req = self._read_json()
+                    png = base64.b64decode(req["png"])
+                    tags = _run_tagger(
+                        png,
+                        req["model_onnx"],
+                        req["model_csv"],
+                        float(req.get("threshold", 0.35)),
+                        float(req.get("character_threshold", 0.85)),
+                        str(req.get("exclude_tags", "")),
+                    )
+                    self._send_json(200, {"tags": tags})
+                    return
+                if route == "/mask":
+                    req = self._read_json()
+                    png = base64.b64decode(req["png"])
+                    mask_png = _run_mask(png, req["model_path"])
+                    self._send_json(200, {"png": base64.b64encode(mask_png).decode("ascii")})
+                    return
+                if route == "/inpaint":
+                    req = self._read_json()
+                    if backend != "sdxl":
+                        self._send_json(400, {"error": "inpaint requires the sdxl backend"})
+                        return
+                    from PIL import Image
+                    fill = np.asarray(Image.open(io.BytesIO(base64.b64decode(req["fill_png"]))).convert("RGB"))
+                    mask = np.asarray(Image.open(io.BytesIO(base64.b64decode(req["mask_png"]))).convert("L"))
+                    img = pipe.inpaint(
+                        fill, mask,
+                        str(req.get("prompt", "")),
+                        negative=str(req.get("negative", "")),
+                        steps=int(req.get("steps", 8)),
+                        cfg=float(req.get("cfg", 2.0)),
+                        seed=int(req.get("seed", 42)),
+                        strength=float(req.get("strength", 1.0)),
+                    )
+                    buf = io.BytesIO()
+                    Image.fromarray(img).save(buf, format="PNG")
+                    self._send_json(200, {"png": base64.b64encode(buf.getvalue()).decode("ascii")})
+                    return
+                if route != "/generate":
+                    self._send_json(404, {"error": "not found"})
+                    return
+
+                req = self._read_json()
+                prompt = str(req.get("prompt", ""))
+                negative = str(req.get("negative", ""))
+                steps = int(req.get("steps", 20))
+                cfg = float(req.get("cfg", 7.5))
+                seed = int(req.get("seed", 42))
+                count = max(1, int(req.get("count", 1)))
+                disable_inc = bool(req.get("disable_seed_increment", False))
+                width = int(req.get("width", pipe.SIZE))
+                height = int(req.get("height", pipe.SIZE))
+
+                self.send_response(200)
+                self.send_header("Content-Type", "application/x-ndjson")
+                self.send_header("Transfer-Encoding", "chunked")
+                self.end_headers()
+
+                def emit(obj):
+                    line = (json.dumps(obj) + "\n").encode("utf-8")
+                    self.wfile.write(f"{len(line):X}\r\n".encode("ascii"))
+                    self.wfile.write(line)
+                    self.wfile.write(b"\r\n")
+                    self.wfile.flush()
+
+                t_start = time.perf_counter()
+                try:
+                    emit({"type": "start", "count": count, "steps": steps, "backend": backend,
+                          "width": width, "height": height})
+                    with lock:
+                        from PIL import Image
+                        for i in range(count):
+                            task_seed = seed if disable_inc else (seed + i)
+                            img_seed = task_seed % (2 ** 31)
+
+                            def on_step(k, total, elapsed=None):
+                                try:
+                                    emit({"type": "progress", "index": i, "step": k, "total": total,
+                                          "elapsed": elapsed or 0.0})
+                                except (BrokenPipeError, ConnectionResetError):
+                                    pass
+
+                            img = pipe.generate(prompt, negative=negative, steps=steps, cfg=cfg,
+                                                seed=img_seed, on_step=on_step,
+                                                width=width, height=height)
+                            buf = io.BytesIO()
+                            Image.fromarray(img).save(buf, format="PNG")
+                            b64 = base64.b64encode(buf.getvalue()).decode("ascii")
+                            emit({"type": "image", "index": i, "seed": img_seed, "png": b64})
+                    emit({"type": "done", "elapsed": time.perf_counter() - t_start})
+                except Exception as e:
+                    import traceback
+                    traceback.print_exc()
+                    try:
+                        emit({"type": "error", "message": str(e)})
+                    except Exception:
+                        pass
+                finally:
+                    try:
+                        self.wfile.write(b"0\r\n\r\n")
+                        self.wfile.flush()
+                    except Exception:
+                        pass
+                return
+
+            except BrokenPipeError:
+                pass
+            except Exception as e:
+                import traceback
+                traceback.print_exc()
+                try:
+                    self._send_json(500, {"error": str(e)})
+                except Exception:
+                    pass
+
+    httpd = ThreadingHTTPServer((args.host, args.port), Handler)
+    print(f"[npu] serving {backend} on http://{args.host}:{args.port} sizes={sizes}", flush=True)
+    try:
+        httpd.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    httpd.server_close()
+
+
+if __name__ == "__main__":
+    main()
