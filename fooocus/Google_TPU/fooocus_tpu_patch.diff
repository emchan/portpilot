diff --git a/tpu_debug_nan.py b/tpu_debug_nan.py
new file mode 100644
index 0000000..77f15b0
--- /dev/null
+++ b/tpu_debug_nan.py
@@ -0,0 +1,150 @@
+"""Headless reproduction of the Fooocus UI generation path on TPU.
+
+Mirrors default_pipeline/async_worker defaults (styles, expansion, LoRA.
+sampler, ADM scaling) and checks every conditioning tensor + UNet output for
+NaN/Inf so we can localise the black-image bug.
+
+Run:  python tpu_debug_nan.py
+      NO_LORA=1 python tpu_debug_nan.py
+"""
+import os
+
+import torch
+
+NO_LORA = os.environ.get('NO_LORA') == '1'
+
+
+def finite(name, t):
+    if not torch.is_tensor(t):
+        print(f"{name}: <not a tensor> {type(t)}")
+        return True
+    ok = torch.isfinite(t).all().item()
+    tf = t.float()
+    print(f"{name}: shape={tuple(t.shape)} dtype={t.dtype} device={t.device} "
+          f"finite={ok} min={tf.min().item():.4g} max={tf.max().item():.4g} "
+          f"nan={torch.isnan(t).sum().item()} inf={torch.isinf(t).sum().item()}")
+    return ok
+
+
+def main():
+    # The UI installs Fooocus's sampling patches before the model is created
+    # (async_worker does `from modules.patch import patch_all; patch_all()`).
+    import modules.patch as patch
+    patch.patch_all()
+
+    if os.environ.get('NO_ANISO') == '1':
+        import modules.anisotropic as anisotropic
+        anisotropic.adaptive_anisotropic_filter = lambda x, g=None: x
+        print("[debug] anisotropic filter DISABLED")
+
+    import modules.default_pipeline as pipeline
+    import modules.sdxl_styles as styles
+    import modules.config as config
+    import modules.core as core
+    import ldm_patched.modules.model_management as mm
+
+    print("\n=== TPU / model management ===")
+    print("is_tpu:", mm.is_tpu(), "device:", mm.get_torch_device())
+    for name in ("final_unet", "final_clip", "final_vae"):
+        obj = getattr(pipeline, name, None)
+        try:
+            dt = obj.model_dtype()
+        except Exception:
+            dt = getattr(obj, "dtype", None)
+        print(f"{name} dtype:", dt, "|", type(obj).__name__ if obj is not None else None)
+    print("attention:", __import__('ldm_patched.ldm.modules.attention', fromlist=['optimized_attention']).optimized_attention)
+
+    if NO_LORA:
+        print("\n=== reloading model WITHOUT LoRA ===")
+        pipeline.refresh_everything(
+            refiner_model_name=config.default_refiner_model_name,
+            base_model_name=config.default_base_model_name,
+            loras=[],
+            vae_name=config.default_vae,
+        )
+
+    width, height = 1152, 896
+    seed = 12345
+    prompt = "a photo of a beautiful landscape, mountains, lake, dramatic sky"
+    style_selections = ["Fooocus V2", "Fooocus Enhance", "Fooocus Sharp"]
+
+    print("\n=== building prompt exactly like async_worker.process_prompt ===")
+    use_expansion = styles.fooocus_expansion in style_selections
+    task_styles = [s for s in style_selections if s != styles.fooocus_expansion]
+    pos_work, neg_work = [], []
+    placeholder_replaced = False
+    for s in task_styles:
+        p, n, has_placeholder = styles.apply_style(s, positive=prompt)
+        placeholder_replaced = placeholder_replaced or has_placeholder
+        pos_work += p
+        neg_work += n
+    if not placeholder_replaced:
+        pos_work = [prompt] + pos_work
+    neg_work = [""] + neg_work
+
+    expansion = pipeline.final_expansion(prompt, seed) if use_expansion else ""
+    print("expansion:", expansion[:160])
+    pos_texts = pos_work + ([expansion] if use_expansion else [])
+    neg_texts = neg_work
+    print("positive texts:", pos_texts)
+    print("negative texts:", neg_texts)
+
+    pipeline.set_clip_skip(1)
+    c = pipeline.clip_encode(texts=pos_texts, pool_top_k=len(pos_work))
+    uc = pipeline.clip_encode(texts=neg_texts, pool_top_k=len(neg_texts))
+
+    print("\n=== conditioning tensors ===")
+    c_ok = True
+    for label, cond in (("positive", c), ("negative", uc)):
+        for cc, pp in cond:
+            c_ok &= finite(f"{label}.c_crossattn", cc)
+            c_ok &= finite(f"{label}.pooled_output", pp["pooled_output"])
+    print("conditioning finite:", c_ok)
+
+    print("\n=== patched ADM embedding (y) ===")
+    ps = patch.PatchSettings(sharpness=2.0, adaptive_cfg=4.0, adm_scaler_end=0.3,
+                             positive_adm_scale=1.5, negative_adm_scale=0.8,
+                             controlnet_softness=0.25)
+    patch.patch_settings[os.getpid()] = ps
+    for label, cond in (("positive", c), ("negative", uc)):
+        pooled = cond[0][1]["pooled_output"]
+        try:
+            y = pipeline.final_unet.model.encode_adm(
+                pooled_output=pooled, width=width, height=height,
+                prompt_type=label, device=mm.get_torch_device())
+            finite(f"{label}.adm_y", y)
+        except Exception as e:
+            print(f"{label}.adm_y FAILED: {type(e).__name__}: {e}")
+
+    steps = int(os.environ.get('STEPS', '30'))
+    print(f"\n=== {steps}-step sampling (dpmpp_2m_sde_gpu / karras, cfg 4, sharpness 2) ===")
+    latent = core.generate_empty_latent(width=width, height=height, batch_size=1)
+    # process_diffusion initialises the Brownian tree before sampling; the SDE
+    # sampler needs it.
+    from ldm_patched.modules.samplers import calculate_sigmas_scheduler
+    sig = calculate_sigmas_scheduler(pipeline.final_unet.model, "karras", steps)
+    sig_pos = sig[sig > 0]
+    patch.BrownianTreeNoiseSamplerPatched.global_init(
+        latent["samples"].to(mm.get_torch_device()),
+        float(sig_pos.min().cpu()), float(sig.max().cpu()), seed=seed, cpu=False)
+
+    out = core.ksampler(
+        model=pipeline.final_unet,
+        positive=c,
+        negative=uc,
+        latent=latent,
+        seed=seed,
+        steps=steps,
+        cfg=4.0,
+        sampler_name="dpmpp_2m_sde_gpu",
+        scheduler="karras",
+        disable_preview=True,
+    )
+    ok = finite("sampled_latent", out["samples"])
+    print("\nRESULT: sampled latent finite =", ok,
+          "| conditioning finite =", c_ok,
+          "| NO_LORA =", NO_LORA)
+
+
+if __name__ == "__main__":
+    main()
