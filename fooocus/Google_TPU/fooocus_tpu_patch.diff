index 0000000..2328862
--- /dev/null
+++ b/tpu_full_generate.py
@@ -0,0 +1,102 @@
+"""Full Fooocus generation through the real default_pipeline path, saved to PNG.
+
+Run:  python tpu_full_generate.py
+      STEPS=8 WIDTH=1152 HEIGHT=896 python tpu_full_generate.py
+
+Prints wall-clock timings and peak TPU HBM usage.
+"""
+import os
+import time
+
+import torch
+
+import modules.patch as patch
+
+patch.patch_all()
+
+import numpy as np
+from PIL import Image
+
+import modules.default_pipeline as pipeline
+import modules.sdxl_styles as styles
+import modules.core as core
+
+width = int(os.environ.get("WIDTH", "1024"))
+height = int(os.environ.get("HEIGHT", "1024"))
+steps = int(os.environ.get("STEPS", "30"))
+seed = int(os.environ.get("SEED", "12345"))
+prompt = "a photo of a beautiful landscape, mountains, lake, dramatic sky"
+style_selections = ["Fooocus V2", "Fooocus Enhance", "Fooocus Sharp"]
+
+
+def build_cond(texts, pool_top_k):
+    pipeline.set_clip_skip(1)
+    return pipeline.clip_encode(texts=texts, pool_top_k=pool_top_k)
+
+
+def report_memory(label):
+    try:
+        dev = torch.accelerator.current_accelerator()
+        mem = torch.accelerator.memory
+        peak = mem.max_memory_allocated(dev)
+        total = mem.get_memory_info(dev)[1]
+        print(f"[mem] {label}: peak_alloc={peak / 2**20:.0f} MiB "
+              f"of {total / 2**20:.0f} MiB device memory", flush=True)
+    except Exception as exc:
+        print(f"[mem] {label}: unavailable ({exc})", flush=True)
+
+
+# --- prompt assembly, mirroring async_worker.process_prompt -------------------
+use_expansion = styles.fooocus_expansion in style_selections
+pos_work, neg_work = [], []
+placeholder_replaced = False
+for s in [x for x in style_selections if x != styles.fooocus_expansion]:
+    p, n, has_placeholder = styles.apply_style(s, positive=prompt)
+    placeholder_replaced = placeholder_replaced or has_placeholder
+    pos_work += p
+    neg_work += n
+if not placeholder_replaced:
+    pos_work = [prompt] + pos_work
+neg_work = [""] + neg_work
+
+expansion = pipeline.final_expansion(prompt, seed) if use_expansion else ""
+pos_texts = pos_work + ([expansion] if use_expansion else [])
+neg_texts = neg_work
+
+t0 = time.perf_counter()
+c = build_cond(pos_texts, pool_top_k=len(pos_work))
+uc = build_cond(neg_texts, pool_top_k=len(neg_texts))
+print(f"[time] text encoding: {time.perf_counter() - t0:.1f}s", flush=True)
+
+for label, cond in (("positive", c), ("negative", uc)):
+    for cc, pp in cond:
+        assert torch.isfinite(cc).all(), f"{label} c_crossattn is not finite"
+        assert torch.isfinite(pp["pooled_output"]).all(), f"{label} pooled_output is not finite"
+
+ps = patch.PatchSettings(sharpness=2.0, adaptive_cfg=4.0, adm_scaler_end=0.3,
+                         positive_adm_scale=1.5, negative_adm_scale=0.8,
+                         controlnet_softness=0.25)
+patch.patch_settings[os.getpid()] = ps
+
+print(f"\n=== process_diffusion {width}x{height}, {steps} steps ===", flush=True)
+t0 = time.perf_counter()
+images = pipeline.process_diffusion(
+    positive_cond=c, negative_cond=uc, steps=steps, switch=0.5,
+    width=width, height=height, image_seed=seed, callback=None,
+    sampler_name="dpmpp_2m_sde_gpu", scheduler_name="karras",
+    cfg_scale=4.0, disable_preview=True)
+print(f"[time] process_diffusion: {time.perf_counter() - t0:.1f}s", flush=True)
+report_memory("after sampling")
+
+img = images[0] if isinstance(images, (list, tuple)) else images
+img = img.float().cpu().numpy() if torch.is_tensor(img) else np.asarray(img)
+if img.dtype != np.uint8:
+    img = (np.clip(img, 0.0, 1.0) * 255.0).round().astype(np.uint8)
+if img.ndim == 4:
+    img = img[0]
+print("image:", img.shape, img.dtype, "min:", int(img.min()), "max:", int(img.max()),
+      "mean:", round(float(img.mean()), 2), flush=True)
+
+out_path = os.environ.get("OUT", "/content/fooocus_tpu_output.png")
+Image.fromarray(img).save(out_path)
+print("saved", out_path, flush=True)
diff --git a/tpu_ui_driver.py b/tpu_ui_driver.py
new file mode 100644
index 0000000..158056b
--- /dev/null
+++ b/tpu_ui_driver.py
@@ -0,0 +1,265 @@
+"""Drive the Fooocus Gradio UI the same way a browser does.
+
+Gradio 3.41 exposes the generation chain over the websocket queue protocol:
+``/queue/join`` for both the ``get_task`` (fn_index 67) and ``generate_clicked``
+(fn_index 68) dependencies.  State components (``currentTask``,
+``state_is_generating``) live server side in ``app.state_holder[session_hash]``,
+so the second call only needs an empty ``data`` list.
+
+Usage::
+
+    python tpu_ui_driver.py --url http://127.0.0.1:7860 \
+        --prompt "a red apple on a wooden table, studio photo" \
+        --steps 8 --outdir outputs/ui_driver
+
+The script prints every queue message it receives and writes the returned
+gallery images to ``--outdir``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import os
+import pathlib
+import sys
+import time
+import urllib.request
+import uuid
+
+import websockets
+
+# Components that never carry a browser-serializable default value.
+_EMPTY_TYPES = {"image", "video", "audio", "file", "model3d", "dataframe", "dataset"}
+
+
+def fetch_config(url: str) -> dict:
+    with urllib.request.urlopen(url.rstrip("/") + "/config", timeout=60) as resp:
+        return json.load(resp)
+
+
+def default_value(component: dict):
+    props = component.get("props", {})
+    ctype = component["type"]
+    value = props.get("value")
+    if ctype in _EMPTY_TYPES:
+        return None
+    if value is not None:
+        return value
+    if ctype == "textbox":
+        return ""
+    if ctype == "number":
+        return 0
+    if ctype == "slider":
+        return props.get("minimum", 0)
+    if ctype == "checkbox":
+        return False
+    if ctype == "checkboxgroup":
+        return []
+    if ctype in ("dropdown", "radio"):
+        choices = props.get("choices") or []
+        return choices[0] if choices else None
+    if ctype == "colorpicker":
+        return "#000000"
+    return None
+
+
+def build_payload(config: dict, fn_index: int) -> list:
+    components = {c["id"]: c for c in config["components"]}
+    inputs = config["dependencies"][fn_index]["inputs"]
+    payload = []
+    for cid in inputs:
+        component = components[cid]
+        if component["type"] == "state":
+            # Gradio keeps state server-side (keyed by session_hash) but the
+            # browser still sends a placeholder slot for every state input.
+            payload.append(None)
+            continue
+        payload.append(default_value(component))
+    return payload
+
+
+async def run_endpoint(ws_url: str, session_hash: str, fn_index: int, data: list,
+                       timeout: float = 1800.0) -> dict:
+    """Run one queued endpoint and return the final ``process_completed`` message."""
+    deadline = time.monotonic() + timeout
+    async with websockets.connect(ws_url, max_size=None, open_timeout=60) as ws:
+        await ws.recv()  # {"msg": "send_hash"}
+        await ws.send(json.dumps({"fn_index": fn_index, "session_hash": session_hash}))
+
+        data_sent = False
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError(f"fn_index={fn_index} produced no result")
+            message = json.loads(await asyncio.wait_for(ws.recv(), timeout=remaining))
+            msg = message.get("msg")
+            if msg in ("estimation", "queue_full"):
+                print(f"[fn {fn_index}] {msg}: {message}", flush=True)
+            elif msg == "send_data":
+                if data_sent:
+                    raise RuntimeError(f"fn_index={fn_index} asked for data twice")
+                await ws.send(json.dumps({
+                    "data": data,
+                    "fn_index": fn_index,
+                    "session_hash": session_hash,
+                }))
+                data_sent = True
+                print(f"[fn {fn_index}] sent {len(data)} inputs", flush=True)
+            elif msg == "process_starts":
+                print(f"[fn {fn_index}] process_starts", flush=True)
+            elif msg == "process_generating":
+                print(f"[fn {fn_index}] process_generating", flush=True)
+            elif msg == "process_completed":
+                output = message.get("output", {})
+                print(f"[fn {fn_index}] process_completed success={message.get('success')} "
+                      f"duration={output.get('duration')}", flush=True)
+                if output.get("error"):
+                    print(f"[fn {fn_index}] server error: {output['error']}", file=sys.stderr)
+                return message
+            else:
+                print(f"[fn {fn_index}] {message}", flush=True)
+
+
+def unwrap_gallery(output) -> list[str]:
+    """Extract saved image paths from a Gallery output."""
+    if isinstance(output, dict):
+        output = output.get("value") or output.get("data") or []
+    paths = []
+    if not isinstance(output, list):
+        return paths
+    for item in output:
+        candidate = item
+        if isinstance(candidate, (list, tuple)) and candidate:
+            candidate = candidate[0]
+        if isinstance(candidate, dict):
+            candidate = candidate.get("name") or candidate.get("data")
+        if isinstance(candidate, str) and candidate:
+            paths.append(candidate)
+    return paths
+
+
+def copy_outputs(paths: list[str], outdir: str) -> list[str]:
+    out = pathlib.Path(outdir)
+    out.mkdir(parents=True, exist_ok=True)
+    saved = []
+    for path in paths:
+        try:
+            if path.startswith("file="):
+                path = path[len("file="):]
+            if os.path.exists(path):
+                dest = out / os.path.basename(path)
+                with open(path, "rb") as src, open(dest, "wb") as dst:
+                    dst.write(src.read())
+                saved.append(str(dest))
+        except OSError as exc:
+            print(f"could not copy {path}: {exc}", file=sys.stderr)
+    return saved
+
+
+async def main_async(args) -> int:
+    config = fetch_config(args.url)
+    ws_url = args.url.rstrip("/").replace("http://", "ws://").replace(
+        "https://", "wss://") + "/queue/join"
+    session_hash = uuid.uuid4().hex[:10]
+
+    get_task_index = args.get_task_fn
+    generate_index = args.generate_fn
+
+    data = build_payload(config, get_task_index)
+    print(f"session_hash={session_hash} get_task fn={get_task_index} values={len(data)}")
+
+    components = {c["id"]: c for c in config["components"]}
+    overrides = {
+        "prompt": args.prompt,
+        "negative_prompt": args.negative_prompt,
+        "steps": args.steps,
+        "image_number": args.image_number,
+        "seed": args.seed,
+    }
+    label_to_id = {}
+    for cid in config["dependencies"][get_task_index]["inputs"]:
+        component = components[cid]
+        props = component.get("props", {})
+        label_to_id.setdefault(str(props.get("label") or props.get("elem_id") or ""), cid)
+
+    def override(label, value):
+        if value is None:
+            return
+        cid = label_to_id.get(label)
+        if cid is None:
+            print(f"warning: no input labelled {label!r}", file=sys.stderr)
+            return
+        index = 0
+        for input_id in config["dependencies"][get_task_index]["inputs"]:
+            if input_id == cid:
+                data[index] = value
+                print(f"override {label!r} (id {cid}) -> {value!r}")
+                break
+            index += 1
+
+    override("positive_prompt", overrides["prompt"])
+    override("Negative Prompt", overrides["negative_prompt"])
+    override("Forced Overwrite of Sampling Step", overrides["steps"])
+    override("Image Number", overrides["image_number"])
+    override("Seed", overrides["seed"])
+
+    started = time.time()
+    first = await run_endpoint(ws_url, session_hash, get_task_index, data)
+    if not first.get("success", False):
+        print("get_task failed", file=sys.stderr)
+        return 1
+    task_output = first.get("output", {}).get("data")
+    print(f"get_task returned state {type(task_output).__name__}")
+
+    second = await run_endpoint(ws_url, session_hash, generate_index,
+                                build_payload(config, generate_index))
+    elapsed = time.time() - started
+    if not second.get("success", False):
+        print("generate_clicked failed", file=sys.stderr)
+        return 1
+
+    outputs = second.get("output", {}).get("data") or []
+    print(f"generate_clicked returned {len(outputs)} outputs in {elapsed:.1f}s")
+    gallery = unwrap_gallery(outputs[-1]) if outputs else []
+    if not gallery:
+        print("no gallery images in output; raw output:")
+        print(json.dumps(outputs, indent=2)[:4000])
