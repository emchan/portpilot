+def is_tpu_backend():
+    """True when torch is running on the native PyTorch TPU backend.
+
+    The pinned requirements are CUDA-era versions (numpy 1.x, torch-free but
+    CUDA-oriented transitive deps).  Installing them on a TPU image can break
+    the pre-installed torch_tpu stack, so dependency installation is skipped
+    there.
+    """
+    try:
+        import torch
+        if hasattr(torch, "accelerator") and torch.accelerator.is_available():
+            accelerator = torch.accelerator.current_accelerator()
+            return accelerator is not None and accelerator.type == "tpu"
+    except Exception:
+        pass
+    return False
+
