+
+def configure_numpy_compat():
+    """Restore NumPy 1.x aliases still referenced by Gradio 3.41.
+
+    The TPU image ships NumPy 2.x (``requirements_versions.txt``'s numpy 1.x
+    pin is intentionally skipped), but Gradio 3.41's image encoder indexes
+    ``np.bool8``/``np.float_`` inside ``processing_utils._convert``.  Without
+    these aliases every numpy preview/output raises AttributeError.
+    """
+    import numpy as np
+
+    aliases = {"bool8": np.bool_, "float_": np.float64}
+    added = []
+    for name, value in aliases.items():
+        if not hasattr(np, name):
+            setattr(np, name, value)
+            added.append(name)
+    if not hasattr(np, "obj2sctype"):
+        np.obj2sctype = lambda obj: np.dtype(obj).type
+        added.append("obj2sctype")
+    if added:
+        print(f"[TPU] Added NumPy 1.x aliases required by Gradio 3.41: {', '.join(added)}.")
+
+
+def configure_gradio_for_slow_backends():
+    """Keep Gradio's internal queue requests alive across slow generator yields.
+
+    Gradio 3.41's queue worker calls its own ``/api/predict`` endpoint through
+    an internal ``httpx.AsyncClient`` created in ``Queue.start()``, which
+    inherits httpx's default 5 second read timeout.  A generator endpoint
+    (Fooocus' Generate chain) only answers once the next yield is ready; on TPU
+    the first diffusion step triggers lazy kernel compilation and can take tens
+    of seconds, so the queue client times out and closes the browser websocket
+    mid-generation.  Disabling the timeout keeps progress/results streaming.
+    """
+    try:
+        import httpx
+        from gradio.queueing import Queue
+
+        if getattr(Queue.start, "_tpu_timeout_patched", False):
+            return
+
+        original_start = Queue.start
+
+        async def start_without_timeout(self, ssl_verify=True):
+            await original_start(self, ssl_verify=ssl_verify)
+            if self.queue_client is not None:
+                self.queue_client.timeout = httpx.Timeout(None)
+
+        start_without_timeout._tpu_timeout_patched = True
+        Queue.start = start_without_timeout
+        print('[TPU] Gradio queue HTTP timeout disabled for slow TPU first steps.')
+    except Exception as exc:
+        print(f'[TPU] Could not extend the Gradio queue timeout: {exc}')
+
+
+if is_tpu_backend():
+    configure_numpy_compat()
+    configure_gradio_for_slow_backends()
+
